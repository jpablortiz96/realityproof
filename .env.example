# ============================================================================
# RealityProof — Environment Configuration Example (NO SECRETS)
# Copy to .env and fill with your Sandbox / Developer credentials.
# ============================================================================

# Server & Environment
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:4000

# Persistence: the API stores state in one JSON file (STATE_FILE_PATH, default inside
# PRIVATE_STORAGE_DIR). DATABASE_URL is NOT read by the running API; the PostgreSQL schema in
# apps/api/src/db is an unused migration path.
# STATE_FILE_PATH=./storage/private-evidence/realityproof-state.json

# Public judge demo (server-enforced read-only, state kept in memory and reseeded on start).
# With NODE_ENV=production the API refuses to start on a published AUTH_TOKEN_SECRET, and on
# published role tokens unless PUBLIC_DEMO_MODE=true.
PUBLIC_DEMO_MODE=false
# Masks a real part maker's name in the historical Sandbox record when it is displayed.
# Stored records and hashes do not change. On by default outside tests.
MASK_THIRD_PARTY_BRANDS=true
# Set to true only behind a reverse proxy, so rate limits see the real client address.
TRUST_PROXY=false
# Daily ceiling of live Gemini agent turns; beyond it the labeled deterministic planner answers.
STUDIO_AGENT_DAILY_TURN_LIMIT=500

# Demo & Epistemic Safety Secret (used for signing read-only Proof Passport links & role tokens)
AUTH_TOKEN_SECRET=dev-only-change-me-in-production-32-chars-min

# Role Demo Tokens (Separated per Role for RBAC enforcement)
DEMO_REQUESTER_TOKEN=rp_req_demo_token_2026
DEMO_VERIFIER_TOKEN=rp_ver_demo_token_2026
DEMO_OPERATOR_TOKEN=rp_op_demo_token_2026
DEMO_EXTERNAL_AGENT_TOKEN=rp_agent_demo_token_2026

# ============================================================================
# PayPal Integration (STRICTLY SANDBOX — Live mode is blocked by guardrails)
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
# ============================================================================
PAYPAL_MODE=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Optional Sandbox Verifier Receiver Email for Payouts v1 testing (if Payouts is enabled on account)
PAYPAL_SANDBOX_VERIFIER_EMAIL=sb-verifier@personal.example.com

# ============================================================================
# Google Gemini API (Server-side Multimodal Structured Output)
# Obtain from: https://aistudio.google.com/app/apikey
# gemini-3.5-flash-lite is the model verified live on 2026-11-05. The API also falls back to
# GEMINI_FALLBACK_MODEL and then gemini-3.5-flash. Without a key the app still runs: analysis
# reports AI_BLOCKED and the Studio agent answers from its labeled deterministic planner.
# ============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Private Evidence Storage
PRIVATE_STORAGE_DIR=./storage/private-evidence
MAX_UPLOAD_BYTES=5242880
EVIDENCE_RETENTION_HOURS=72

